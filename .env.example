# UPC API Institucional — Environment Variables
# Copy this file to .env and fill in the real values

# ----- Database -----
DATABASE_URL=postgresql+asyncpg://upc_user:upc_password@localhost:5432/upc_api
AUDIT_DATABASE_URL=postgresql+asyncpg://upc_user:upc_password@localhost:5433/upc_audit

# ----- Redis -----
REDIS_URL=redis://localhost:6379

# ----- Keycloak / OIDC -----
KEYCLOAK_JWKS_URL=https://auth.unicesar.edu.co/realms/upc/protocol/openid-connect/certs
KEYCLOAK_ISSUER=https://auth.unicesar.edu.co/realms/upc
API_AUDIENCE=upc-api-institucional

# ----- Application -----
ENVIRONMENT=sandbox
RATE_LIMIT_PER_MINUTE=200
JWKS_CACHE_TTL_SECONDS=3600
